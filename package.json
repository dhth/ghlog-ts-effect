{
  "name": "ghlog-ts-effect",
  "version": "0.1.0",
  "description": "",
  "bin": {
    "ghlog-ts-effect": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "chmod +x dist/index.js",
    "check": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "format": "biome format --write src vitest.*.ts",
    "lint": "biome check src vitest.*.ts",
    "lint:ci": "biome ci src vitest.*.ts",
    "lint:fix": "biome check --write src vitest.*.ts",
    "test": "vitest run --config vitest.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@effect/vitest": "4.0.0",
    "@types/node": "^25.9.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0",
    "effect": "4.0.0"
  }
}
